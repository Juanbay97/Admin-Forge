# Copy to deploy/.env and edit. Placeholders only: secrets never go here (they live in deploy/secrets/).

# Public name of the server. Must resolve (DNS A/AAAA) to this host before FORGE_TLS=acme can work.
FORGE_DOMAIN=forge.example.test
# Empty in production (standard 443). For a non-standard HTTPS port write it with the colon, e.g. :8443.
FORGE_PORT_SUFFIX=

# acme = public certificate from Let's Encrypt (needs ports 80 and 443 reachable from the internet).
# internal = Caddy's own CA (private networks and local proofs; browsers need its root certificate).
FORGE_TLS=acme
FORGE_ACME_EMAIL=admin@example.test

# Host ports published by Caddy (the only published service) and the address they bind to.
FORGE_HTTP_PORT=80
FORGE_HTTPS_PORT=443
FORGE_PUBLISH_ADDRESS=0.0.0.0

# Comma-separated https origins the gateway client may call; empty keeps the built-in default.
FORGE_GATEWAY_ORIGINS=

# Email (invitations and password resets). Required: the control plane refuses to start without a relay.
# Resend: FORGE_SMTP_HOST=smtp.resend.com FORGE_SMTP_PORT=465 FORGE_SMTP_SECURITY=tls (or 587 with starttls),
# FORGE_SMTP_USER=resend and the API key in deploy/secrets/smtp_password. Amazon SES: see docs/deploy.md.
FORGE_SMTP_HOST=smtp.example.test
FORGE_SMTP_FROM=forge@example.test
FORGE_SMTP_SECURITY=starttls
FORGE_SMTP_PORT=587
FORGE_SMTP_USER=relay-user
FORGE_SMTP_PASSWORD_FILE=/run/secrets/smtp_password

# Capability-policy key rotation: the PUBLIC keys of retired signing keys (space or comma separated, at most 8). Empty = none.
# Not a secret. See "Rotate the policy signing key" in docs/deploy.md.
FORGE_POLICY_RETIRED_KEYS=

FORGE_LOG_LEVEL=INFO
FORGE_IMAGE=forge-control-plane:local
FORGE_DOWNLOADS_DIR=./downloads
FORGE_SECRETS_DIR=./secrets

# Backups: UTC cron (5 fields), how many dumps to keep, and the host directory they are written to.
# Create the directory first and set FORGE_UID/FORGE_GID to the user that owns it (id -u, id -g).
FORGE_BACKUP_CRON="30 2 * * *"
FORGE_BACKUP_KEEP=14
FORGE_BACKUPS_DIR=./backups
FORGE_UID=1000
FORGE_GID=1000
