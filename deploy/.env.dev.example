# Local proof: copy to deploy/.env.dev and run
#   docker compose -f compose.yml -f compose.dev.yml --env-file .env.dev up -d --build --wait
# Placeholders only. Mail goes to Mailpit (web UI and API on http://127.0.0.1:8025), never to the internet.
FORGE_DOMAIN=localhost
FORGE_PORT_SUFFIX=:8443
FORGE_TLS=internal
FORGE_HTTP_PORT=8080
FORGE_HTTPS_PORT=8443
FORGE_MAILPIT_PORT=8025
FORGE_SMTP_HOST=mailpit
FORGE_SMTP_FROM=forge@example.test
FORGE_SMTP_SECURITY=none
FORGE_SMTP_PORT=1025
# Metering proof: a fake gateway over https (see the fake-gateway service in compose.dev.yml for the one-time setup).
FORGE_FAKE_GATEWAY_DIR=./dev-gateway
FORGE_GATEWAY_ORIGINS=https://fake-gateway:3413
# Connector broker proof: a fake OAuth provider and MCP server (compose.dev.yml); the smoke writes fixtures.json into this directory.
FORGE_FAKE_CONNECTORS_DIR=./dev-connectors
