{
  "contract_version": "forge-mvp/1",
  "error_codes": ["AUTHENTICATION_TEMPORARILY_BLOCKED", "DEPARTMENT_EXISTS", "EXISTING_ACCOUNT_AUTH_REQUIRED", "INVALID_REQUEST", "LAST_ADMIN", "MEMBERSHIP_SUSPENDED", "NOT_FOUND", "REVISION_CONFLICT", "SERVICE_UNAVAILABLE", "UNAUTHENTICATED"],
  "error_envelope": ["error.code", "error.message", "error.request_id", "error.reset_at", "error.retry_after_seconds", "error.retryable"],
  "routes": [
    {"auth": "bearer", "errors": [], "method": "POST", "path": "/forge/v1/accounts/disable", "request": [], "responses": {"204": []}},
    {"auth": "bearer", "errors": [422], "method": "POST", "path": "/forge/v1/accounts/invitations", "request": ["department_id", "email", "name", "organization_id"], "responses": {"201": ["delivery_channel", "delivery_state", "expires_at", "invitation_id"]}},
    {"auth": "none", "errors": [422], "method": "POST", "path": "/forge/v1/accounts/invitations/accept", "request": ["capability", "invitation_id", "password"], "responses": {"201": ["account_id", "department_id", "membership_id", "organization_id"]}},
    {"auth": "none", "errors": [401, 422, 429, 503], "method": "POST", "path": "/forge/v1/accounts/login", "request": ["email", "password"], "responses": {"200": ["access_token", "expires_at", "token_type"]}},
    {"auth": "bearer", "errors": [], "method": "POST", "path": "/forge/v1/accounts/logout", "request": [], "responses": {"204": []}},
    {"auth": "bearer", "errors": [401, 403, 404, 503], "method": "GET", "path": "/forge/v1/accounts/me", "request": [], "responses": {"200": ["account.display_name", "account.email", "account.id", "organizations[].departments[].id", "organizations[].departments[].name", "organizations[].display_name", "organizations[].id", "organizations[].roles", "organizations[].status"]}},
    {"auth": "none", "errors": [422], "method": "POST", "path": "/forge/v1/accounts/password-reset/consume", "request": ["capability", "password"], "responses": {"204": []}},
    {"auth": "none", "errors": [422], "method": "POST", "path": "/forge/v1/accounts/password-reset/request", "request": ["email"], "responses": {"202": ["delivery_channel", "status"]}},
    {"auth": "bearer", "errors": [401, 403, 404, 422, 503], "method": "GET", "path": "/forge/v1/bootstrap", "request": [], "responses": {"200": ["config_revision", "membership.id", "organization.display_name", "organization.id", "organization.slug", "schema_version"]}},
    {"auth": "none", "errors": [], "method": "GET", "path": "/forge/v1/contract", "request": [], "responses": {"200": ["contract_version", "schema_sha256"]}},
    {"auth": "bearer", "errors": [401, 403, 409, 422, 503], "method": "POST", "path": "/forge/v1/organizations/{organization_id}/initial-administrator", "request": ["expected_revision", "membership_id", "operation_id"], "responses": {"200": ["audit_publication", "event_id", "membership_id", "operation_id", "organization_id", "revision"]}},
    {"auth": "bearer", "errors": [401, 404, 422, 503], "method": "POST", "path": "/forge/v1/orgs/{organization_id}/chat/completions", "request": ["max_output_tokens", "messages[].content", "messages[].role", "model", "stream"], "responses": {"200": ["text/event-stream"]}},
    {"auth": "bearer", "errors": [401, 404, 422, 503], "method": "GET", "path": "/forge/v1/orgs/{organization_id}/departments", "request": [], "responses": {"200": ["departments[].id", "departments[].name"]}},
    {"auth": "bearer", "errors": [401, 404, 409, 422, 503], "method": "POST", "path": "/forge/v1/orgs/{organization_id}/departments", "request": ["name"], "responses": {"201": ["id", "name"]}},
    {"auth": "bearer", "errors": [401, 404, 422, 503], "method": "GET", "path": "/forge/v1/orgs/{organization_id}/gateway", "request": [], "responses": {"200": ["allowed_endpoints", "endpoint", "revision", "status"]}},
    {"auth": "bearer", "errors": [401, 404, 409, 422, 503], "method": "PUT", "path": "/forge/v1/orgs/{organization_id}/gateway", "request": ["api_key", "endpoint", "expected_revision"], "responses": {"200": ["endpoint", "revision", "status"]}},
    {"auth": "bearer", "errors": [401, 404, 409, 422, 503], "method": "POST", "path": "/forge/v1/orgs/{organization_id}/gateway/catalogue/refresh", "request": [], "responses": {"200": ["capability_state", "gateway_revision", "model_ids", "verification"]}},
    {"auth": "bearer", "errors": [401, 404, 422, 503], "method": "GET", "path": "/forge/v1/orgs/{organization_id}/gateway/catalogue/status", "request": [], "responses": {"200": ["catalogue_revision", "default_model", "publication_state"]}},
    {"auth": "bearer", "errors": [401, 404, 422, 503], "method": "GET", "path": "/forge/v1/orgs/{organization_id}/members", "request": [], "responses": {"200": ["members[].departments[].id", "members[].departments[].name", "members[].display_name", "members[].email", "members[].id", "members[].roles", "members[].status"]}},
    {"auth": "bearer", "errors": [401, 404, 422, 503], "method": "POST", "path": "/forge/v1/orgs/{organization_id}/members/{member_id}/reactivate", "request": [], "responses": {"200": ["departments[].id", "departments[].name", "display_name", "email", "id", "roles", "status"]}},
    {"auth": "bearer", "errors": [401, 404, 409, 422, 503], "method": "POST", "path": "/forge/v1/orgs/{organization_id}/members/{member_id}/suspend", "request": [], "responses": {"200": ["departments[].id", "departments[].name", "display_name", "email", "id", "roles", "status"]}},
    {"auth": "bearer", "errors": [401, 404, 422, 503], "method": "GET", "path": "/forge/v1/orgs/{organization_id}/models", "request": [], "responses": {"200": ["default_model", "models[].capability_state", "models[].id", "models[].input_modalities", "models[].max_context_tokens", "models[].max_output_tokens", "models[].output_modalities", "models[].streaming", "models[].tools", "models[].verification", "organization_id", "revision"]}},
    {"auth": "bearer", "errors": [401, 404, 409, 422, 503], "method": "POST", "path": "/forge/v1/orgs/{organization_id}/models/publish", "request": ["aliases{}", "default_alias", "expected_catalogue_revision", "expected_gateway_revision", "operation_id"], "responses": {"200": ["default_model", "models", "revision"]}}
  ]
}
