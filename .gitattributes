# Files executed on a Linux server must keep LF endings even when checked out on Windows.
Dockerfile text eol=lf
*.sh text eol=lf
deploy/Caddyfile text eol=lf
deploy/compose*.yml text eol=lf
deploy/.env.example text eol=lf
deploy/postgres/initdb/*.sql text eol=lf
deploy/.env.dev.example text eol=lf
tests/fixtures/gateway/*.sse text eol=lf
